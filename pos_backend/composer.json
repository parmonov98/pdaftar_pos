{
    "$comment": [
        "pDaftar POS backend.",
        "",
        "This application stands on its own: its own database, its own models, its",
        "own users. It used to map `App\\` to ../../backend/app/ so that a POS sale",
        "was written by pDaftar's own StoreDebtUseCase \u2014 which meant it could not be",
        "installed, tested or booted without a checkout of pDaftar beside it.",
        "",
        "Integration with pDaftar happens over the API, not through shared classes."
    ],
    "name": "pdaftar/pos-backend",
    "type": "project",
    "description": "pDaftar POS Integration API",
    "keywords": [
        "pdaftar",
        "pos"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "darkaonline/l5-swagger": "^9.0",
        "irazasyed/telegram-bot-sdk": "^3.13",
        "laravel/framework": "^12.64",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "predis/predis": "^2.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.21"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "Pos\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
