{
    "$comment": [
        "pDaftar POS — a monorepo holding the POS backend and the till frontend.",
        "",
        "The key line is the `App\\` autoload mapping below. It points at pDaftar's",
        "backend, NOT at a copy, so a POS sale is written by pDaftar's own",
        "StoreDebtUseCase and the two cannot drift apart. Copying those files would",
        "put two versions of the sale rules against one database.",
        "",
        "CONSEQUENCE: this repository does not run on its own. pdaftar.backend must",
        "be checked out as a SIBLING of this repository:",
        "",
        "    parent/",
        "      backend/       <- git clone pdaftar.backend",
        "      pdaftar_pos/   <- this repo",
        "",
        "`php artisan pos:health` and GET /api/pos/v1/health check the link and say",
        "so plainly when it is missing."
    ],
    "name": "pdaftar/pos-backend",
    "type": "project",
    "description": "pDaftar POS Integration API",
    "keywords": [
        "pdaftar",
        "pos"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "darkaonline/l5-swagger": "^9.0",
        "irazasyed/telegram-bot-sdk": "^3.13",
        "laravel/framework": "^12.64",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10",
        "predis/predis": "^2.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.21"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "Pos\\": "app/",
            "App\\": "../../backend/app/",
            "Database\\Factories\\": "../../backend/database/factories/",
            "Database\\Seeders\\": "../../backend/database/seeders/"
        },
        "files": [
            "../../backend/bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
