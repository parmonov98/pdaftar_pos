# pos.pdaftar.uz — devdata server.
#
# Copy to pos_backend/.env on the server and fill in the two secrets. Never
# commit the filled-in file; .env is gitignored.
#
#   cp .env.devdata.example .env
#
# The values that matter are at the bottom. Everything above is ordinary
# Laravel config.

APP_NAME="pDaftar POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.pdaftar.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── pDaftar's database ─────────────────────────────────────────────────────
# The POS has no books of its own: a sale is written into pDaftar's tables by
# pDaftar's own StoreDebtUseCase. Pointing this at a fresh/empty database does
# not fail loudly — it produces a POS with nothing to sell from. pos:health
# checks the `shops` table is non-empty for exactly that reason.
#
# `mariadb` and `redis` are pDaftar's container names, reachable because this
# service joins pdaftar_dev_network.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=shopdept
DB_USERNAME=root
DB_PASSWORD=          # ← same as backend/.env DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ─── The queue namespace ────────────────────────────────────────────────────
# THE subtle one. A nasiya sale dispatches ProcessDebtBalanceAndSms, which is
# what recomputes the client's balance. Redis keys are namespaced by prefix,
# and Laravel derives the default from APP_NAME — so naming this app
# "pDaftar POS" would queue into `pdaftar_pos_database_`, a namespace pDaftar's
# horizon never reads. Nothing errors. Balances simply stop updating, and you
# find out weeks later.
#
# So the prefix is pinned explicitly rather than inherited from APP_NAME, and
# POS_EXPECTED_REDIS_PREFIX makes pos:health assert the two still match.
# pDaftar's APP_NAME is `pdaftar`, so its prefix is `pdaftar_database_`.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=pdaftar_database_
POS_EXPECTED_REDIS_PREFIX=pdaftar_database_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="pos@pdaftar.uz"
MAIL_FROM_NAME="${APP_NAME}"

L5_SWAGGER_CONST_HOST=https://pos.pdaftar.uz
